APP_NAME="Dapur Rantau"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://domain-anda
# APP_KEY: buat sekali pada instalasi baru; pertahankan saat update (DEPLOYMENT.md).

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_STACK=daily, LOG_LEVEL=info; lindungi akses file log.

DB_CONNECTION=sqlite
# Reverse proxy: daftar IP/CIDR eksplisit proxy di depan aplikasi (wildcard ditolak). Kosong = tidak ada proxy dipercaya.
TRUSTED_PROXIES=
# x-forwarded (X-Forwarded-For/Host/Port/Proto) atau forwarded (RFC 7239), sesuai proxy yang benar-benar dipakai.
TRUSTED_PROXY_HEADERS=x-forwarded
# SQLite production: DB_DATABASE=/var/lib/dapur-rantau/database.sqlite (di luar public/).
# Production disarankan: DB_JOURNAL_MODE=wal, DB_SYNCHRONOUS=normal, DB_BUSY_TIMEOUT=5000.
# Kosong = perilaku development saat ini (journal bawaan file, busy timeout 1000 ms).
DB_JOURNAL_MODE=
DB_SYNCHRONOUS=
DB_BUSY_TIMEOUT=1000
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Aktifkan hanya pada server HTTPS production: SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MAX_OUTPUT_TOKENS=3000
GEMINI_THINKING_LEVEL=minimal
RECIPE_CACHE_ENABLED=true
RECIPE_CACHE_TTL=86400


# Google OAuth (isi sendiri; tidak ada credential dalam repository)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Midtrans: wajib eksplisit "sandbox" atau "production"; kosong = pembayaran nonaktif.
MIDTRANS_ENVIRONMENT=sandbox
# Webhook POST /api/midtrans/notification; aktifkan hanya setelah URL publik disetujui.
MIDTRANS_WEBHOOK_ENABLED=false
MIDTRANS_WEBHOOK_RATE_LIMIT=120
# Penutupan refund unknown hanya untuk pengembangan dan ditolak di Production (tidak ada variabel untuk menyalakannya).
# Opsional: email operator untuk alert anomali pembayaran (refund_excess, refund tertutup yang muncul di Midtrans).
PAYMENT_ALERT_EMAIL=
# Credential Sandbox (SB-Mid-server-..., SB-Mid-client-...). Signature Secret Key terpisah dari Server Key.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SIGNATURE_SECRET_KEY=
# Credential Production (Mid-server-..., Mid-client-...). Tidak pernah fallback ke Sandbox.
MIDTRANS_PRODUCTION_SERVER_KEY=
MIDTRANS_PRODUCTION_CLIENT_KEY=
MIDTRANS_PRODUCTION_SIGNATURE_SECRET_KEY=
